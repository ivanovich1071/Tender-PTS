# Секреты. Никаких исключений из этого правила: в соседнем проекте ключ
# OpenRouter едва не уехал на GitHub через .env.example, попавший в исключения.
.env
.env.*
*.key
*.pem

# Виртуальное окружение и кэш
.venv/
__pycache__/
*.py[cod]

# Рабочие данные: база, скачанная документация, кэш ответов модели
work/
*.db
*.db-wal
*.db-shm

# Выгрузки разведки — данные, а не код
recon/out/

# PyCharm складывает в .idea много личного и машинно-зависимого.
# Конфигурации запуска — исключение: они общие и нужны в репозитории.
.idea/*
!.idea/runConfigurations/

# Сборка десктопной версии: 37 МБ временных файлов, пересобирается командой
# .venv/Scripts/python.exe build_desktop.py
build/
dist/

# Прочее
.DS_Store
Thumbs.db
*.log

# Локальные настройки Claude Code — там бывают ключи.
.claude/settings.local.json
